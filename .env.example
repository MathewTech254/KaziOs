# =============================================================================
# Core Infrastructure
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kazios?schema=public"
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Authentication & Sessions
# =============================================================================
SESSION_SECRET="dev-session-secret-change-in-production-32chars-min"
JWT_SECRET="dev-jwt-secret-change-in-production-32chars-min"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"

# =============================================================================
# Application URLs
# =============================================================================
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
APP_PORT="3000"
API_PORT="4000"

# Injected by Render/Railway/Fly/Koyeb. Local development uses API_PORT above.
PORT="4000"
# Exact origin of the web app in production (no trailing slash, never "*").
# The API refuses to boot in production without it.
CORS_ORIGIN="http://localhost:3000"

# Web build time variables (baked into the bundle by Vite, so they are not
# secrets and must be set on the host that builds the web app).
# VITE_API_URL="https://your-api.onrender.com/api/v1"
# Raise this when the API host sleeps between requests (free tiers).
VITE_API_TIMEOUT_MS="90000"

# =============================================================================
# Paystack (set to empty to disable)
# =============================================================================
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# =============================================================================
# M-PESA / Safaricom Daraja (set to empty to disable)
# =============================================================================
# The M-PESA option at checkout appears only when all four values below are set,
# exactly as the card option depends on PAYSTACK_SECRET_KEY. MPESA_ENVIRONMENT is
# "sandbox" by default so a half-configured server can never push a prompt against
# real money; set it to "production" when you put live credentials in.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_ENVIRONMENT="sandbox"
# Where Safaricom posts STK results (must be an HTTPS URL reachable from the
# internet; locally, use an ngrok tunnel and set this to it). Defaults to
# ${API_URL}/api/v1/webhooks/mpesa when unset.
# MPESA_CALLBACK_URL=""

# =============================================================================
# Subscriptions and entitlements
# =============================================================================
# How long a resolved plan snapshot is reused before it is read again, in
# milliseconds. Entitlements change when a payment lands, a plan changes or a
# period rolls over, none of which happens between two requests a second apart.
# The window is short rather than invalidated precisely because the worker runs
# in a separate process and cannot push an invalidation into the API.
# Set to 0 to resolve from the database on every request.
ENTITLEMENT_CACHE_TTL_MS="15000"

# How often the worker reconciles subscriptions: applies downgrades whose moment
# has arrived, moves lapsed rows into grace and then to expired, and writes the
# transitions to the ledger.
#
# This is not what makes the product behave correctly. The API derives each
# subscription's real status from the clock on every request, so a business whose
# card failed is handled correctly whether or not this has run. The sweep exists
# so the admin area and the ledger agree with the checks the product runs, and so
# a long outage of the worker cannot leave a stale ACTIVE on the record.
SUBSCRIPTION_SWEEP_MS="3600000"

# =============================================================================
# eTIMS / KRA Integration (set to empty to disable)
# =============================================================================
ETIMS_API_URL=""
ETIMS_CLIENT_ID=""
ETIMS_CLIENT_SECRET=""
ETIMS_CERTIFICATE=""
ETIMS_TIN=""
ETIMS_PHYSICAL_ADDRESS=""
ETIMS_MANUFACTURER_NAME=""
ETIMS_MAIN_ACTIVITY=""
ETIMS_SUBCATEGORY=""

# =============================================================================
# Email (set to empty to log emails to console only)
# =============================================================================
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@kazios.test"
EMAIL_FROM_NAME="KaziOS"

# =============================================================================
# SMS (set to empty to disable)
# =============================================================================
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_FROM="+254700000000"

# =============================================================================
# WhatsApp (set to empty to disable)
# =============================================================================
WHATSAPP_PROVIDER="console"
WHATSAPP_API_KEY=""
WHATSAPP_FROM=""

# =============================================================================
# Object Storage
# =============================================================================
OBJECT_STORAGE_PROVIDER="local"
OBJECT_STORAGE_BUCKET="kazios"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_REGION="us-east-1"

# =============================================================================
# AI Gateway (set to empty to disable AI features)
# =============================================================================
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS="4000"
AI_TEMPERATURE="0.1"

# =============================================================================
# Security
# =============================================================================
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
ENCRYPTION_KEY="dev-encryption-key-32-bytes-min!!!1"

# =============================================================================
# Environment
# =============================================================================
NODE_ENV="development"
LOG_LEVEL="debug"
ENABLE_REGISTRATION="true"
ENABLE_DEMO_SEED="true"
