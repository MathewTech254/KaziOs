{
  "name": "@kazios/validation",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=.*\\.test\\.ts$ --passWithNoTests",
    "test:integration": "jest --testPathPattern=.*\\.integration\\.ts$ --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
