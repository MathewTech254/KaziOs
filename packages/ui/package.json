{
  "name": "@kazios/ui",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=.*\\.test\\.ts$ --passWithNoTests",
    "test:integration": "jest --testPathPattern=.*\\.integration\\.ts$ --passWithNoTests"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.2"
  }
}
