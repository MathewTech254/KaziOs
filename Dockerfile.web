# Build stage: compiles the shared packages, then the Vite bundle.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --include=dev
COPY . .
RUN npm run build:packages && npm run build --workspace=@kazios/web

# Runtime stage: nginx serves the static bundle and proxies /api to the API service,
# so the browser only ever talks to one origin.
FROM nginx:1.27-alpine AS runner
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]