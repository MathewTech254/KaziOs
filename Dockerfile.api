# Build stage: needs the full toolchain (typescript, prisma CLI) to compile.
# node_modules is copied from the host into the runner stage (see the final
# COPY in the runner stage), so this stage deliberately does NOT run "npm ci".
# Doing so would hit the Docker daemon's unreliable outbound network. The host
# build (npm ci at the repo root) already installed all workspace packages.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
COPY . .
RUN npx prisma generate --schema apps/api/prisma/schema.prisma
RUN npm run build:packages && npm run build --workspace=@kazios/api

# Runtime stage: production dependencies plus the generated Prisma client.
# node_modules is NOT installed here: we copy the pre-built host workspace
# node_modules instead, so the container never runs "npm ci" and never needs
# outbound network access.
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json .npmrc ./
# The .npmrc at the workspace root is "include=dev"; the runner stage only needs
# production deps, so step it aside and let the copied node_modules provide them.
RUN mv .npmrc .npmrc.build && mv .npmrc.build .npmrc
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY packages/ai/package.json ./packages/ai/
COPY packages/config/package.json ./packages/config/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/validation/package.json ./packages/validation/
# The client is generated in the build stage, so skip the postinstall generate here.
# include=dev in .npmrc would otherwise defeat --omit=dev, so step that file aside
# for the (optional) production-only install.
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
# Copy the full host workspace node_modules (dev + prod) into the runner stage.
# This guarantees every dependency the API needs at runtime is present without
# ever running "npm ci", so the container has no outbound network requirement.
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 4000
# Migrations are applied out of band: npx prisma migrate deploy --schema apps/api/prisma/schema.prisma
CMD ["node", "apps/api/dist/index.js"]
