{
  "name": "@kazios/worker",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@kazios/types": "1.0.0",
    "@kazios/api": "1.0.0",
    "@kazios/integrations": "1.0.0",
    "@kazios/config": "1.0.0",
    "@kazios/ai": "1.0.0",
    "@prisma/client": "^5.15.0",
    "bullmq": "^5.3.0",
    "ioredis": "^5.4.1",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
