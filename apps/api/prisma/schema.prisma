generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  country          String
  currency         String
  timezone         String
  language         String   @default("en")
  taxNumber        String?
  businessCategory String?
  address          String?
  phone            String?
  email            String?
  status           String   @default("ACTIVE")
  /// The plan this business is on, kept in step with its Subscription inside the same
  /// transaction. It exists so "which plan is this business on" is answerable without a
  /// join on every request; the Subscription row remains the record of truth, and
  /// nothing is granted from this column on its own.
  plan             Plan?    @relation(fields: [planId], references: [id])
  planId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  roles          Role[]
  branches       Branch[]
  warehouses     Warehouse[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  products       Product[]
  customers      Customer[]
  suppliers      Supplier[]
  categories     Category[]
  taxCategories  TaxCategory[]
  accounts       Account[]
  invoices       Invoice[]
  payments       Payment[]
  journals       JournalEntry[]
  apiKeys        ApiKey[]
  webhooks       WebhookEndpoint[]
  automations    AutomationRule[]
  projects       Project[]
  tasks          Task[]
  leads          Lead[]
  tickets        SupportTicket[]
  /// One business holds at most one subscription, so this is singular rather than a list.
  /// The uniqueness is enforced by the unique index on Subscription.organizationId.
  subscription    Subscription?
  auditLogs      AuditLog[]
  notifications  Notification[]
  files          File[]
  settings       Setting[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  cardPayments   CardPayment[]
  quotations     Quotation[]
  expenses       Expense[]
  expenseCategories ExpenseCategory[]
  subscriptionPayments SubscriptionPayment[]
  usageRecords   UsageRecord[]
  entitlementOverrides EntitlementOverride[]
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  status        String    @default("INVITED")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  roles          UserRole[]
  sessions       Session[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  tasks          Task[]
  stockTransfers StockTransfer[]
  purchaseOrders PurchaseOrder[]
  passwordResetTokens PasswordResetToken[]
  // Named relations, because a user both records and approves expenses and Prisma will
  // not infer which of the two foreign keys a back reference refers to.
  recordedExpenses Expense[] @relation("ExpenseRecordedBy")
  approvedExpenses Expense[] @relation("ExpenseApprovedBy")
  // Platform administration is recorded against the user rather than against a business
  // role, so owning a shop can never imply authority over the platform.
  subscriptionEvents SubscriptionEvent[]
  platformAdmin    PlatformAdmin?
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userAgent    String?
  ip           String?

  user User @relation(fields: [userId], references: [id])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  permissions String[]
  createdAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  users          UserRole[]
}

model UserRole {
  id          String  @id @default(uuid())
  userId      String
  roleId      String
  branchId    String?
  warehouseId String?

  user      User       @relation(fields: [userId], references: [id])
  role      Role       @relation(fields: [roleId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([userId, roleId, branchId])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  users          UserRole[]
  warehouses     Warehouse[]
  invoices       Invoice[]
  payments       Payment[]
  orders         SalesOrder[]
  purchases      PurchaseOrder[]
  expenses       Expense[]
  quotations     Quotation[]
  stockMovements StockMovement[]

  @@unique([organizationId, code])
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String
  address   String?
  createdAt DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id])
  organizationId  String
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  inventories     Inventory[]
  stockMovements  StockMovement[]
  sourceTransfers StockTransfer[] @relation("stockTransferSource")
  destTransfers   StockTransfer[] @relation("stockTransferDest")
  purchaseOrders  PurchaseOrder[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id])
  organizationId String
  products       ProductCategory[]

  @@unique([organizationId, name])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
}

model TaxCategory {
  id        String   @id @default(uuid())
  name      String
  rate      Float
  mode      String   @default("EXCLUSIVE")
  createdAt DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  invoiceItems   InvoiceItem[]
  products       Product[]

  @@unique([organizationId, name])
}

model Product {
  id           String   @id @default(uuid())
  sku          String?
  barcode      String?
  name         String
  description  String?
  costPrice    Float
  sellingPrice Float
  minStock     Int      @default(0)
  reorderPoint Int      @default(0)
  isActive     Boolean  @default(true)
  productType  String   @default("PHYSICAL")
  trackStock   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id])
  organizationId    String
  brandId           String?
  taxCategoryId     String?
  unitId            String?
  brand             Brand?              @relation(fields: [brandId], references: [id])
  unit              Unit?               @relation(fields: [unitId], references: [id])
  taxCategory       TaxCategory?        @relation(fields: [taxCategoryId], references: [id])
  inventories       Inventory[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseOrderItem[]
  stockMovements    StockMovement[]
  stockTransfers    StockTransfer[]
  productCategories ProductCategory[]

  @@unique([organizationId, sku])
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Unit {
  id       String    @id @default(uuid())
  name     String
  code     String    @unique
  products Product[]
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String?
  address      String?
  taxNumber    String?
  customerType String   @default("INDIVIDUAL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  invoices       Invoice[]
  payments       Payment[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  leads          Lead[]

  @@unique([organizationId, name])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  taxNumber String?
  createdAt DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([organizationId, name])
}

model Account {
  id        String   @id @default(uuid())
  code      String
  name      String
  type      String
  parent    String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  status        String   @default("DRAFT")
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Float
  taxTotal      Float
  discountTotal Float    @default(0)
  total         Float
  currency      String
  notes         String?
  terms         String?
  paymentTerms  String?
  paidAmount    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  customer       Customer?     @relation(fields: [customerId], references: [id])
  customerId     String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  branchId       String?
  idempotencyKey String?       @unique
  items          InvoiceItem[]
  payments       Payment[]
  cardPayments   CardPayment[]
}

model InvoiceItem {
  id             String  @id @default(uuid())
  productId      String?
  description    String
  quantity       Float
  unitPrice      Float
  discountAmount Float   @default(0)
  taxRateId      String?
  taxAmount      Float   @default(0)
  lineTotal      Float

  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  invoiceId   String
  product     Product?     @relation(fields: [productId], references: [id])
  taxCategory TaxCategory? @relation(fields: [taxRateId], references: [id])
}

model Payment {
  id          String    @id @default(uuid())
  reference   String    @unique
  amount      Float
  currency    String
  provider    String
  methodType  String
  status      String    @default("PENDING")
  providerRef String?
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  invoiceId      String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  customerId     String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?
}

model JournalEntry {
  id          String   @id @default(uuid())
  reference   String   @unique
  description String
  journalDate DateTime
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  lines          JournalLine[]
}

model JournalLine {
  id          String  @id @default(uuid())
  accountId   String
  description String?
  debit       Float   @default(0)
  credit      Float   @default(0)

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  journalEntryId String
  account        Account      @relation(fields: [accountId], references: [id])
}

model Inventory {
  id       String @id @default(uuid())
  quantity Float
  reserved Float  @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String

  @@unique([productId, warehouseId])
}

model StockMovement {
  id        String   @id @default(uuid())
  type      String
  quantity  Float
  reason    String?
  reference String?
  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  product     Product   @relation(fields: [productId], references: [id])
  productId   String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String
  branch      Branch?   @relation(fields: [branchId], references: [id])
  branchId    String?
}

model StockTransfer {
  id        String    @id @default(uuid())
  quantity  Float
  reference String?
  status    String    @default("PENDING")
  notes     String?
  completedAt DateTime?
  createdAt DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  sourceWarehouse        Warehouse @relation("stockTransferSource", fields: [sourceWarehouseId], references: [id])
  sourceWarehouseId      String
  destinationWarehouse   Warehouse @relation("stockTransferDest", fields: [destinationWarehouseId], references: [id])
  destinationWarehouseId String
  product                Product   @relation(fields: [productId], references: [id])
  productId              String
  createdBy              User?     @relation(fields: [createdById], references: [id])
  createdById            String?

  @@index([organizationId])
  @@index([status])
}

model SalesOrder {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  customer       Customer     @relation(fields: [customerId], references: [id])
  customerId     String
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     String    @unique
  status       String    @default("DRAFT")
  expectedDate DateTime?
  notes        String?
  currency     String?
  subtotal     Float     @default(0)
  taxRate      Float     @default(0)
  taxTotal     Float     @default(0)
  totalAmount  Float     @default(0)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id])
  organizationId String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  supplierId     String
  branch         Branch?             @relation(fields: [branchId], references: [id])
  branchId       String?
  warehouse      Warehouse?          @relation(fields: [warehouseId], references: [id])
  warehouseId    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])
  createdById    String?
  items          PurchaseOrderItem[]

  @@index([organizationId, status])
}

model PurchaseOrderItem {
  id        String  @id @default(uuid())
  quantity  Float
  unitPrice Float
  lineTotal Float
  description String?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
}

model Quotation {
  id          String   @id @default(uuid())
  quoteNumber String   @unique
  validUntil  DateTime
  notes       String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  customer       Customer     @relation(fields: [customerId], references: [id])
  customerId     String
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?
}

// A category of spending, owned by one organization.
//
// This was a bare `categoryId` string on Expense with no table behind it, so every
// expense either carried a meaningless id or nothing at all, and no report could group
// spend. A business cannot answer "where did the money go" without it.
//
// `accountCode` is the ledger account the category posts to, which is what lets a
// recorded expense produce a real journal entry instead of a number that only exists in
// a list. The codes are seeded per organization from the defaults below.
model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  // The account this category charges, e.g. "6000" for rent. Nullable so an
  // organization can add a category before an accountant has mapped its account.
  accountCode String?
  createdAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  expenses       Expense[]

  @@unique([organizationId, name])
}

model Expense {
  id            String   @id @default(uuid())
  vendorName    String
  amount        Float
  currency      String
  expenseDate   DateTime
  paymentMethod String
  receiptNumber String?
  notes         String?
  createdAt     DateTime @default(now())

  // A cash expense leaves the till; a credit one is still owed to whoever was paid.
  // Money already spent is not quietly editable, so a recorded expense is corrected by
  // voiding it and recording the right one, which is what the audit trail has to show.
  status        String   @default("RECORDED")
  // When set, a reversal entry was written to cancel the original, so the ledger stays
  // balanced and the history of what happened is never erased.
  voidedAt      DateTime?
  voidReason    String?
  journalEntryId String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  categoryId     String?
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])
  branchId       String?
  project        Project?     @relation(fields: [projectId], references: [id])
  projectId      String?
  // Who recorded it and who approved it. An expense claimed by staff is a claim until
  // somebody with authority signs it off, so the approver is part of the record.
  recordedById   String?
  recordedBy     User?        @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  approvedById   String?
  approvedBy     User?        @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  @@index([organizationId, expenseDate])
  @@index([organizationId, categoryId])
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  createdAt   DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  tasks          Task[]
  expenses       Expense[]
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  project        Project?     @relation(fields: [projectId], references: [id])
  projectId      String?
  assignee       User?        @relation(fields: [assigneeId], references: [id])
  assigneeId     String?
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  status    String   @default("NEW")
  source    String?
  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  customer       Customer?    @relation(fields: [customerId], references: [id])
  customerId     String?
}

model SupportTicket {
  id          String   @id @default(uuid())
  subject     String
  description String
  category    String
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  key       String    @unique
  scopes    String[]
  expiresAt DateTime?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  name      String
  url       String
  events    String[]
  isActive  Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model AutomationRule {
  id            String   @id @default(uuid())
  name          String
  trigger       String
  triggerConfig String?
  conditions    Json?
  actions       Json
  isActive      Boolean  @default(true)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id])
  organizationId String
  executions     AutomationExecution[]
}

model AutomationExecution {
  id        String   @id @default(uuid())
  status    String   @default("PENDING")
  result    Json?
  error     String?
  createdAt DateTime @default(now())

  automation   AutomationRule @relation(fields: [automationId], references: [id])
  automationId String
}

/// One row per business. A business has at most one live subscription at a time, and
/// this row is the single authority on what it has paid for and until when.
///
/// Status is stored as well as derived, because "ACTIVE" is worth recording when a
/// payment is confirmed, but it is never trusted on its own at read time: dates pass
/// while the process is not running, so the effective status is recomputed from the
/// clock on every read. The stored status is the last state this system deliberately
/// moved to; the effective status is the truth right now.
model Subscription {
  id             String    @id @default(uuid())
  organizationId String    @unique

  plan          Plan       @relation("subscriptionPlan", fields: [planId], references: [id])
  planId        String

  /// The price this subscription is actually billed at. Storing the price rather than
  /// only the plan means a later price rise does not retroactively charge an existing
  /// customer the new number part way through a period they have already paid for.
  planPrice     PlanPrice? @relation(fields: [planPriceId], references: [id])
  planPriceId   String?

  status           String    @default("ACTIVE")
  billingInterval  String    @default("monthly")

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// Set when the plan offers a trial. While it is in the future the business has paid
  /// nothing and holds the trial plan's entitlements.
  trialEndsAt DateTime?

  /// How long a business keeps working after a renewal fails. This is the difference
  /// between a declined card and a business that cannot serve customers, so it is a
  /// deliberate period rather than a missing field.
  graceEndsAt DateTime?

  /// Cancellations are normally scheduled rather than immediate.
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  /// When a cancellation actually takes effect. Kept apart from canceledAt because
  /// "cancel now" and "cancel at the end of the period I already paid for" are
  /// different promises to the customer.
  endsAt      DateTime?

  provider                    String?
  providerCustomerId          String?
  providerSubscriptionCode    String?

  /// A card is described by a brand and four digits. The full number and any token are
  /// never stored: they belong to the provider, and keeping them here would turn this
  /// table into something worth stealing.
  paymentMethodBrand  String?
  paymentMethodLast4  String?
  paymentMethodExpiry String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   SubscriptionEvent[]
  payments SubscriptionPayment[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A plan change requested for the end of the current period. A downgrade waits for
  /// the period to end rather than taking effect at once and refunding the difference,
  /// because a business that paid for a year keeps that year's limits until it ends.
  pendingPlan         Plan?     @relation("pendingPlan", fields: [pendingPlanId], references: [id])
  pendingPlanId       String?
  pendingPlanChangeAt DateTime?

  @@index([status])
  @@index([planId])
}

/// A capability that can be switched on for a business.
///
/// `available` is the honesty guard for the pricing page. A feature can exist in the
/// catalog, be granted by a plan and be enforced by the API before it has a user
/// facing screen; advertising it before then would be selling something nobody can
/// reach. The public catalogue only lists available features, and turning this on is
/// the deliberate step that makes a feature sellable.
model Feature {
  key         String  @id
  name        String
  description String
  category    String
  available   Boolean @default(false)
  sortOrder   Int     @default(0)

  plans PlanFeature[]

  @@index([category, sortOrder])
}

/// What one plan gives one business.
///
/// A plan is the sellable unit: a name, a price, the features it turns on and the
/// limits it sets. Plans are rows rather than constants so an administrator can
/// re-price or retire one without a deployment, and so Enterprise is an ordinary
/// private plan rather than a special case in the code.
model Plan {
  id          String  @id @default(uuid())
  /// Stable, human readable identifier, used in URLs, metadata and plan overrides.
  key         String  @unique
  name        String
  description String
  /// DRAFT plans are not offered. ARCHIVED plans keep working for existing customers
  /// but stop being sold.
  status      String  @default("ACTIVE")
  visibility  String  @default("PUBLIC")
  /// Exactly one plan carries this, and it is where every new business starts. The
  /// service falls back to it, so retiring the default cannot leave a business with
  /// nothing at all.
  isDefault   Boolean @default(false)
  sortOrder   Int     @default(0)
  /// Free of charge for the whole period, e.g. Community. Distinct from a zero priced
  /// trial, because it is the price rather than the introduction.
  isFree      Boolean @default(false)
  trialDays   Int     @default(0)
  /// A yearly price quoted per month, e.g. 1658 for "two months free". Presentation
  /// only: the amount charged is always the PlanPrice for the interval bought.
  yearlyPerMonthCents Int?
  highlight   String?

  prices   PlanPrice[]
  features PlanFeature[]
  limits   PlanLimit[]

  subscriptions         Subscription[]         @relation("subscriptionPlan")
  scheduledSubscriptions Subscription[]        @relation("pendingPlan")
  payments              SubscriptionPayment[]
  organizations         Organization[]

  @@index([status, visibility, sortOrder])
}

/// One price for one billing interval.
///
/// Split from Plan so monthly and yearly are two rows rather than a flag, which is what
/// makes a future discount, a promotional price or a third interval a data change
/// rather than a migration. A `CUSTOM` interval carries no amount at all: Enterprise is
/// quoted, not sold from a page.
model PlanPrice {
  id          String @id @default(uuid())
  planId      String
  interval    String
  /// Integer minor units. Money is never held as a float here, for the same reason it
  /// is not held as a float on an invoice.
  amountCents Int
  currency    String @default("USD")
  /// Whether a business can check out on this interval now. A yearly price can be
  /// withdrawn from sale while monthly continues.
  isActive    Boolean @default(true)

  /// The Paystack plan this price charges through. Created lazily on the first checkout
  /// that needs it, then stored here: recurring billing runs on the provider's own
  /// billing engine (plan -> customer -> subscription -> webhook), not on a local
  /// imitation of it. Unique because two servers racing to create the same plan must
  /// end up sharing one code rather than leaving an orphan at Paystack.
  paystackPlanCode String? @unique

  plan          Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, interval, currency])
  @@index([planId, isActive])
}

/// A capability a plan turns on.
///
/// A join rather than a string array on Plan, because a capability is a row with its own
/// name and description that several plans share. The pricing page can then render one
/// description consistently instead of repeating the same sentence per plan and letting
/// the copies drift apart.
model PlanFeature {
  id     String @id @default(uuid())
  planId String
  /// References Feature.key rather than a surrogate id: a feature is named by its key
  /// everywhere else in the system, and matching that here means a migration seeds the
  /// catalogue without having to look ids up first.
  featureKey String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
}

/// An allowance a plan sets.
///
/// `source` decides how it is measured, and getting this right is the difference
/// between a limit that is true and one that is merely stored: COUNTED limits are read
/// from live rows, METERED limits from accumulated counters.
model PlanLimit {
  id     String @id @default(uuid())
  planId String
  key    String
  value  Int
  source String
  unit   String @default("count")
  /// Whether the allowance resets each billing period. An annual allowance must not
  /// silently become monthly, and a seat count must not reset at all.
  period String @default("never")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key])
}

/// The subscription ledger: append only, and never updated in place.
///
/// A business asking "what happened to my plan" is answered from here. The current
/// Subscription row can only ever describe the present, which is exactly the question a
/// customer who was downgraded, charged twice or left in grace is asking.
model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String
  type           String
  fromStatus     String?
  toStatus       String?
  fromPlanId     String?
  toPlanId       String?
  /// Why it happened, in words a support agent can read: "Paystack reported failed".
  reason         String?
  metadata       Json?
  /// Set when a person caused this, as opposed to a webhook or the nightly sweep.
  actorUserId    String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([type])
}

/// One row per payment attempt for a subscription, which is also the invoice history a
/// business sees in Settings.
///
/// The row is written when checkout opens and only becomes SUCCESS once the provider has
/// confirmed the money, either by a signed webhook or by the server asking the provider
/// directly. No path exists that marks it paid from a browser's word.
model SubscriptionPayment {
  id             String   @id @default(uuid())
  subscriptionId String
  organizationId String
  planId         String

  /// Provider facing. Unique, so a retried checkout cannot create a second charge and a
  /// replayed webhook always resolves to the same row.
  reference      String   @unique
  /// A caller supplied key, unique per organization, so a double tap on "Upgrade" cannot
  /// open two checkouts for one intent.
  idempotencyKey String?  @unique

  amountCents     Int
  currency        String
  kind            String  @default("INITIAL")
  status          String  @default("PENDING")
  /// The interval this payment was opened for. Recorded on the payment rather than read
  /// back off the subscription, because a payment must state what it is paying for even
  /// when the subscription it settles has already moved on.
  billingInterval String  @default("monthly")

  provider         String  @default("PAYSTACK")
  providerRef      String?
  authorizationUrl String?

  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?
  failureReason String?

  refundedAt   DateTime?
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
  @@index([subscriptionId, status])
  @@index([status, createdAt])
}

/// Accumulated usage for one metered limit in one period.
///
/// Only METERED limits (AI requests, API calls, storage, transactions) live here.
/// COUNTED limits (users, branches, products) are counted from live rows instead,
/// because a stored counter that drifts from reality is worse than no counter: it would
/// refuse a customer who is within their allowance, or promise one who is not.
model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String
  /// One of LIMIT_KEYS. Not a foreign key to a catalog table: the set of metered limits
  /// is code, and adding one should not need a migration.
  key            String
  quantity       Int      @default(0)
  /// The period this quantity belongs to, as an inclusive start. The end is derived from
  /// the limit's period rather than stored, so a change to how long a period lasts cannot
  /// leave two rows disagreeing about when it ends.
  periodStart    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, periodStart])
  @@index([organizationId, key])
}

/// A deliberate exception to a plan, granted by a platform administrator.
///
/// This is how enterprise contracts, sales exceptions and goodwill grants are expressed
/// without inventing a plan per customer: one row grants a feature or raises a limit for
/// one business, with a reason and an optional expiry. It is the only way to exceed a
/// plan, and it is always attributable to somebody.
model EntitlementOverride {
  id             String   @id @default(uuid())
  organizationId String
  /// A feature key when kind is FEATURE, empty for a limit row.
  featureKey     String?
  /// A limit key when kind is LIMIT, empty for a feature row.
  limitKey       String?
  kind           String
  /// For a feature, true grants it. For a limit, the allowance that replaces the plan's.
  value          Json?
  reason         String
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// A person who administers the platform rather than a business on it.
///
/// Deliberately a separate table from Role. A business Owner holds `*` inside their own
/// organization, and that must never mean anything here: platform authority is granted
/// deliberately, by scope, and is revocable without touching a business's own roles.
model PlatformAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  scopes    String[]
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  changes   Json
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  user           User?        @relation(fields: [userId], references: [id])
  userId         String?
}

model Notification {
  id        String    @id @default(uuid())
  channel   String
  type      String
  title     String
  body      String
  status    String    @default("PENDING")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// A stable identity for the thing being announced, e.g. "low-stock:<product>:<warehouse>".
  /// The same problem can be detected repeatedly (a sweep runs every few minutes), so the
  /// key lets an alert be raised once and then stay quiet until the condition clears,
  /// instead of filling a user's list with identical rows.
  dedupeKey String?

  /// Where the browser should take the user when the notification is opened.
  link String?

  /// Who or what caused it, e.g. the cashier who rang the sale.
  actorName String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  userId         String

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, userId, readAt])
  @@index([dedupeKey, createdAt])
}

model File {
  id        String   @id @default(uuid())
  filename  String
  mime      String
  size      Int
  url       String
  type      String
  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
}

model Setting {
  id    String @id @default(uuid())
  key   String
  value Json

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@unique([organizationId, key])
}

// A password reset token. Only the SHA-256 hash of the token that was emailed is
// stored, so someone who reads this table still cannot use a link to take over an
// account.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// A card payment taken through Paystack. The row is written when the customer opens the
// payment popup and only moves to SUCCESS when Paystack confirms the money, either by a
// signed webhook or by the server asking Paystack directly. No value here is ever set
// from something the browser supplied.
model CardPayment {
  id               String    @id @default(uuid())
  reference        String    @unique
  invoiceId        String
  organizationId   String
  amountCents      Int
  currency         String
  email            String
  status           String    @default("PENDING")
  providerRef      String?
  authorizationUrl String?
  paidAt           DateTime?
  failureReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([invoiceId])
}

/// One row per Paystack webhook event this installation has ever seen.
///
/// The unique provider event id is the idempotency guarantee the whole webhook path
/// needs: Paystack retries deliveries, and a replay must be acknowledged without being
/// applied a second time. A retried event collides on `providerEventId`, is recognised
/// as already processed, and answers 200 without touching a subscription.
///
/// The payload is stored as received so a failed event can be re-driven from the table
/// itself rather than depending on the provider still being able to resend it.
model PaymentWebhookEvent {
  id                String   @id @default(uuid())
  /// Paystack's own event id. When a payload somehow lacks one, a hash of the raw body
  /// stands in, which still dedupes byte-identical redeliveries.
  providerEventId   String   @unique
  /// The event name as Paystack sent it, e.g. "charge.success".
  event             String
  /// The transaction reference when the event carries one, for looking a charge up.
  reference         String?
  /// The business this event was ultimately applied to, when one could be found.
  organizationId    String?
  /// The full payload, for re-driving a failure and for support answering "what did
  /// Paystack actually send us at 03:12".
  payload           Json
  /// RECEIVED -> PROCESSED / IGNORED / FAILED. A row left in RECEIVED means a process
  /// died mid-handling, and the next delivery of the same event is safe to retry.
  status            String   @default("RECEIVED")
  error             String?
  createdAt         DateTime @default(now())
  processedAt       DateTime?

  @@index([event, createdAt])
  @@index([status, createdAt])
  @@index([reference])
}
