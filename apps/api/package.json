{
  "name": "@kazios/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles --forceExit",
    "test:unit": "jest --detectOpenHandles --forceExit --testPathPattern='.*\\.test\\.ts$'",
    "test:integration": "jest --detectOpenHandles --forceExit --testPathPattern='.*\\.integration\\.ts$'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "ts-node src/utils/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@kazios/ai": "1.0.0",
    "@kazios/config": "1.0.0",
    "@kazios/integrations": "1.0.0",
    "@kazios/types": "1.0.0",
    "@kazios/validation": "1.0.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.40.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.3.0",
    "connect-redis": "^8.0.1",
    "cookie-parser": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "express-session": "^1.17.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.214",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^5.15.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
