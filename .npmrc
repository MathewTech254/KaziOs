# Hosted platforms (Render, Cloudflare Pages) set NODE_ENV=production during the build,
# and npm then skips devDependencies. This project is compiled on the host, where
# typescript, @types/*, eslint and jest all live in devDependencies, so dev installs
# are always required here.
#
# Note: npm resolves include=dev in preference to any --omit=dev, on the command line
# as well, so a production-only install must first step this file aside. The Docker
# runtime stages do exactly that (see Dockerfile.api and Dockerfile.worker).
include=dev

engine-strict=false
